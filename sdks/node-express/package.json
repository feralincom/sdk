{
  "name": "@feralin/express",
  "version": "0.1.0",
  "description": "Feralin Node.js SDK için Express ara katmanı: istek başına izin ve kimlik geçirme, isteğe bağlı http_request olayı.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node ../../scripts/sdk-e2e/run.mjs node-express"
  },
  "peerDependencies": {
    "@feralin/node": "^0.1.0",
    "express": "^4.18.0 || ^5.0.0"
  },
  "devDependencies": {
    "@feralin/node": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "express": "^5.3.0",
    "typescript": "^5.9.0"
  },
  "publishConfig": { "access": "public" }
}
