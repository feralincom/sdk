<Project>
  <PropertyGroup>
    <Version>0.1.0</Version>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Authors>Feralin</Authors>
    <Company>Feralin</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>feralin;analytics;attribution;utp;maui</PackageTags>
    <PackageProjectUrl>https://feralin.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/feralincom/sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Paket herkese açık depodan (feralincom/sdk) yayınlanır: geliştirme deposunun commit kimliği nuspec'e ve sürüm bilgisine girmesin. -->
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
