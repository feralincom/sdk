{
    "name": "feralin/feralin-symfony",
    "version": "0.1.0",
    "description": "Feralin PHP SDK için Symfony paketi: yapılandırma, istek olay dinleyicisi ve denetleyici argümanı.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["feralin", "analytics", "attribution", "symfony"],
    "require": {
        "php": ">=8.1",
        "feralin/feralin-php": "^0.1",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/event-dispatcher": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "repositories": [
        { "type": "path", "url": "../php" }
    ],
    "autoload": {
        "psr-4": { "Feralin\\Symfony\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Feralin\\Symfony\\Tests\\": "tests/" }
    },
    "archive": { "exclude": ["/tests"] },
    "scripts": { "test": "phpunit tests" },
    "config": { "sort-packages": true }
}
