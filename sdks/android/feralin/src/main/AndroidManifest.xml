<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Olay gönderimi için. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Ağ geri geldiğinde kuyruğu boşaltmak için; konum veya kimlik bilgisi sağlamaz. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Meta Install Referrer: Facebook, Instagram ve Facebook Lite uygulamalarının sağlayıcısını görmek için (Android 11+ paket görünürlüğü). -->
    <queries>
        <package android:name="com.facebook.katana" />
        <package android:name="com.instagram.android" />
        <package android:name="com.facebook.lite" />
        <!-- Huawei AppGallery kurulum yönlendiricisi: AppGallery'nin içerik sağlayıcısını görmek için. -->
        <package android:name="com.huawei.appmarket" />
        <!-- Samsung Galaxy Store kurulum yönlendiricisi: Galaxy Store'un servisine bağlanmak için (Samsung'un kendi kütüphanesiyle aynı kayıt). -->
        <package android:name="com.sec.android.app.samsungapps" />
    </queries>
</manifest>
