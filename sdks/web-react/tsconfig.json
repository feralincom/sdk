{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist/esm",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    // CommonJS derlemesi (Node10 çözümlemesi) paket alt yollarını okumaz; tip bildirimi doğrudan gösterilir. Çıktıdaki belirteç değişmez.
    "paths": { "@feralin/web/errors": ["./node_modules/@feralin/web/dist/errors.d.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
