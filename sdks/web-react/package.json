{
  "name": "@feralin/react",
  "version": "0.1.0",
  "description": "Feralin Web SDK için React bağdaştırıcısı: Provider, hook ve Next.js App Router bileşeni. SSR güvenli.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/esm/index.d.ts", "default": "./dist/esm/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    },
    "./next": {
      "import": { "types": "./dist/esm/next.d.ts", "default": "./dist/esm/next.js" },
      "require": { "types": "./dist/cjs/next.d.ts", "default": "./dist/cjs/next.js" }
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/sdk-e2e/run.mjs web-react"
  },
  "peerDependencies": {
    "@feralin/web": "^0.1.0",
    "next": ">=13.4.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "next": { "optional": true }
  },
  "devDependencies": {
    "@feralin/web": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^30.1.3",
    "next": "^16.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": { "access": "public" }
}
