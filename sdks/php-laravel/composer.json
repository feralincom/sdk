{
    "name": "feralin/feralin-laravel",
    "version": "0.1.0",
    "description": "Feralin PHP SDK için Laravel entegrasyonu: servis sağlayıcı, ara katman ve facade.",
    "type": "library",
    "license": "MIT",
    "keywords": ["feralin", "analytics", "attribution", "laravel"],
    "require": {
        "php": ">=8.1",
        "feralin/feralin-php": "^0.1",
        "illuminate/contracts": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "repositories": [
        { "type": "path", "url": "../php" }
    ],
    "autoload": {
        "psr-4": { "Feralin\\Laravel\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Feralin\\Laravel\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Feralin\\Laravel\\FeralinServiceProvider"],
            "aliases": { "Feralin": "Feralin\\Laravel\\Facades\\Feralin" }
        }
    },
    "archive": { "exclude": ["/tests"] },
    "scripts": { "test": "phpunit tests" },
    "config": { "sort-packages": true }
}
