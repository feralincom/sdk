<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play Install Referrer kitaplığı (Android atfı). External Dependency Manager for Unity (EDM4U) kuruluysa Android çözümlemesinde
     bu bağımlılığı Gradle'a ekler. EDM4U yoksa aynı satırı projenin mainTemplate.gradle dosyasına elle ekleyin:
     implementation 'com.android.installreferrer:installreferrer:2.2' -->
<dependencies>
  <androidPackages>
    <androidPackage spec="com.android.installreferrer:installreferrer:2.2">
      <repositories>
        <repository>https://maven.google.com</repository>
      </repositories>
    </androidPackage>
  </androidPackages>
</dependencies>
