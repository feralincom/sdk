{
  "name": "@feralin/angular",
  "version": "0.2.0",
  "description": "Feralin Web SDK için Angular bağdaştırıcısı: provideFeralin ve FeralinService. Angular SSR güvenli.",
  "license": "MIT",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/sdk-e2e/run.mjs web-angular"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "@feralin/web": "^0.1.0 || ^0.2.0"
  },
  "devDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@feralin/web": "workspace:*",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.3",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": { "access": "public" }
}
